{
  "identifier": "familiar-windows",
  "windows": ["pet", "chat", "settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-familiar-invoke",
    "allow-pet-hit",
    "allow-pet-drag-start",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
